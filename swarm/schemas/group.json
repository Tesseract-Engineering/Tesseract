{
  "$id": "group.json",
  "additionalProperties": false,
  "description": "Who is in a group that item ACLs name. The graph side checks a viewer\nagainst an item by expanding its group principals through these.",
  "properties": {
    "id": {
      "description": "The group principal, e.g. group:slack:T01ACME:channel:C42AUTH:members",
      "pattern": "^group:(github|jira|slack|gdrive):\\S+$",
      "title": "Id",
      "type": "string"
    },
    "members": {
      "description": "Users by email, nested groups, or source identities (person:{source}:{handle}) where the source gives no email",
      "items": {
        "pattern": "^(user:[^@\\s]+@[^@\\s]+|group:(github|jira|slack|gdrive):\\S+|person:[^:\\s]+:[^:\\s]+)$",
        "type": "string"
      },
      "title": "Members",
      "type": "array"
    },
    "name": {
      "default": "",
      "description": "Display name; mutable, never used for matching",
      "title": "Name",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "record_type": {
      "const": "group",
      "default": "group",
      "title": "Record Type",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "2",
      "default": "2",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "enum": [
        "github",
        "jira",
        "slack",
        "gdrive"
      ],
      "title": "Source",
      "type": "string"
    },
    "unresolved": {
      "default": 0,
      "description": "Members the source listed but could not name",
      "minimum": 0,
      "title": "Unresolved",
      "type": "integer"
    }
  },
  "required": [
    "run_id",
    "id",
    "source",
    "observed_at"
  ],
  "title": "GroupRecord",
  "type": "object",
  "x-ontology-version": 2
}
