# Copy to .env and fill in. .env is git-ignored; never commit it.

# --- data -----------------------------------------------------------------
# The company's export folder (see docs/ADAPTERS.md for the layout). Docker
# mounts it read-only; for local runs, set TESSERACT_DATA to the same path.
DATA_DIR=/path/to/company-exports
# TESSERACT_DATA=/path/to/company-exports
# Optional: a company file elsewhere (default: company.json in the data folder).
# TESSERACT_COMPANY=/path/to/company.json
# Graph namespace; one per company.
TESSERACT_NS=tesseract:acme
# Adapter for the data folder: auto (default), workspace or generic.
# TESSERACT_ADAPTER=auto

# --- Neo4j ----------------------------------------------------------------
NEO4J_PASSWORD=change-me
# NEO4J_URI=neo4j://localhost:7687        # local runs; compose sets its own
# NEO4J_USER=neo4j
# NEO4J_DATABASE=neo4j

# --- model (optional; without one, answers use keyword search only) ---------
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# GEMINI_API_KEY=
# LLM_PROVIDER=anthropic
# LLM_MAX_PER_MINUTE=30
# LLM_MAX_PER_DAY=1500

# --- API --------------------------------------------------------------------
# API_PORT=8091
# Comma-separated browser origins allowed to call the API (default *).
# API_CORS_ORIGINS=http://localhost:8080
# The API's URL as the browser sees it; baked into the UI build.
# PUBLIC_API_URL=http://localhost:8091
# Where approvals, the query log and outbox drafts are kept.
# TESSERACT_STATE=./var
# TESSERACT_OUTBOX=./var/outbox

# Rebuild the graph on the next start even if it already exists.
# FORCE_REBUILD=1
