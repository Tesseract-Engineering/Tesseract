# Copy to .env and fill in. .env is git-ignored; never commit it.

# Swarm local dev bucket (swarm/compose.yaml). Defaults work as-is.
S3_BUCKET=staging
STORAGE_ACCESS_KEY=swarm-dev
STORAGE_SECRET_KEY=swarm-dev-secret

# Swarm GitHub pipeline. App mode (the customer's read-only App):
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
# its private key goes in data/github/app.pem (mounted by swarm/compose.yaml)
# ...or token mode, for a sandbox before an App exists:
GITHUB_TOKEN=
# Comma-separated owner/name list; narrows App scope, required with a token.
GITHUB_REPOS=
# Repos whose bare "#123" means an outside tracker (e.g. Trac), not GitHub.
GITHUB_EXTERNAL_TRACKER_REPOS=
SWARM_BACKFILL_DAYS=730

# Swarm Slack pipeline. The bot token of the customer's internal app
# (pipelines/slack/app-manifest.yaml); scope is the channels it is invited to.
SLACK_BOT_TOKEN=
# Comma-separated channel names or ids; narrows scope.
SLACK_CHANNELS=
# For a cold start from an export (--export): the workspace's URL, and its
# team id if users.json cannot tell (T0123ABCD).
SLACK_WORKSPACE_URL=
SLACK_TEAM_ID=

# Swarm Drive pipeline. The service account's JSON key goes in
# data/gdrive/service-account.json (mounted by swarm/compose.yaml).
# Comma-separated shared drive names or ids; narrows the drives it joined.
GDRIVE_DRIVES=
# Comma-separated ids of folders shared with the service account, for a
# Google account without Workspace (the id is the end of the folder's URL).
GDRIVE_FOLDERS=

# Swarm LLM extraction (swarm/model.py). anthropic in local dev, bedrock in a
# customer VPC, off to skip extraction.
SWARM_MODEL_BACKEND=anthropic
SWARM_MODEL=claude-opus-5-5
SWARM_MODEL_EFFORT=medium
# anthropic only: on sends each run's extractions as one Message Batch (half
# price); off makes one direct call per item.
SWARM_MODEL_BATCH=on
# How long a run waits for its batch before leaving it to the next run.
SWARM_BATCH_WAIT_MINUTES=60
# Tokens per run before extraction stops and the rest wait for the next run;
# blank means no limit.
SWARM_LLM_TOKEN_BUDGET=2000000
ANTHROPIC_API_KEY=
# Bedrock only
AWS_REGION=
